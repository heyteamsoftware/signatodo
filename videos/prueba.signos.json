{"video": "prueba.mp4", "duracion": 24.34, "modelo": "small", "segmentos": [{"t0": 0.0, "t1": 1.02, "texto": "Hola, buenos días.", "palabras": [{"t0": 0.0, "t1": 0.22, "texto": "Hola,"}, {"t0": 0.5, "t1": 0.68, "texto": "buenos"}, {"t0": 0.68, "t1": 1.02, "texto": "días."}]}, {"t0": 2.26, "t1": 3.22, "texto": "Me llamo Simena.", "palabras": [{"t0": 2.26, "t1": 2.5, "texto": "Me"}, {"t0": 2.5, "t1": 2.74, "texto": "llamo"}, {"t0": 2.74, "t1": 3.22, "texto": "Simena."}]}, {"t0": 3.76, "t1": 5.82, "texto": "Hoy la familia quiere comer en casa.", "palabras": [{"t0": 3.76, "t1": 3.98, "texto": "Hoy"}, {"t0": 3.98, "t1": 4.32, "texto": "la"}, {"t0": 4.32, "t1": 4.7, "texto": "familia"}, {"t0": 4.7, "t1": 5.06, "texto": "quiere"}, {"t0": 5.06, "t1": 5.32, "texto": "comer"}, {"t0": 5.32, "t1": 5.54, "texto": "en"}, {"t0": 5.54, "t1": 5.82, "texto": "casa."}]}, {"t0": 6.5, "t1": 9.98, "texto": "Mi hermano bebe agua y mi madre prepara una ensalada con tomate.", "palabras": [{"t0": 6.5, "t1": 6.62, "texto": "Mi"}, {"t0": 6.62, "t1": 7.04, "texto": "hermano"}, {"t0": 7.04, "t1": 7.26, "texto": "bebe"}, {"t0": 7.26, "t1": 7.52, "texto": "agua"}, {"t0": 7.52, "t1": 7.86, "texto": "y"}, {"t0": 7.86, "t1": 7.98, "texto": "mi"}, {"t0": 7.98, "t1": 8.2, "texto": "madre"}, {"t0": 8.2, "t1": 8.66, "texto": "prepara"}, {"t0": 8.66, "t1": 8.84, "texto": "una"}, {"t0": 8.84, "t1": 9.36, "texto": "ensalada"}, {"t0": 9.36, "t1": 9.58, "texto": "con"}, {"t0": 9.58, "t1": 9.98, "texto": "tomate."}]}, {"t0": 10.54, "t1": 13.26, "texto": "Por la tarde los niños van al colegio en autobús.", "palabras": [{"t0": 10.54, "t1": 10.7, "texto": "Por"}, {"t0": 10.7, "t1": 10.86, "texto": "la"}, {"t0": 10.86, "t1": 11.12, "texto": "tarde"}, {"t0": 11.12, "t1": 11.48, "texto": "los"}, {"t0": 11.48, "t1": 11.78, "texto": "niños"}, {"t0": 11.78, "t1": 12.06, "texto": "van"}, {"t0": 12.06, "t1": 12.24, "texto": "al"}, {"t0": 12.24, "t1": 12.7, "texto": "colegio"}, {"t0": 12.7, "t1": 12.8, "texto": "en"}, {"t0": 12.8, "t1": 13.26, "texto": "autobús."}]}, {"t0": 13.84, "t1": 16.5, "texto": "Mañana iremos a la playa si hace buen tiempo.", "palabras": [{"t0": 13.84, "t1": 14.3, "texto": "Mañana"}, {"t0": 14.3, "t1": 14.76, "texto": "iremos"}, {"t0": 14.76, "t1": 14.9, "texto": "a"}, {"t0": 14.9, "t1": 14.98, "texto": "la"}, {"t0": 14.98, "t1": 15.4, "texto": "playa"}, {"t0": 15.4, "t1": 15.7, "texto": "si"}, {"t0": 15.7, "t1": 15.9, "texto": "hace"}, {"t0": 15.9, "t1": 16.1, "texto": "buen"}, {"t0": 16.1, "t1": 16.5, "texto": "tiempo."}]}, {"t0": 16.98, "t1": 17.36, "texto": "¿Y tú?", "palabras": [{"t0": 16.98, "t1": 17.22, "texto": "¿Y"}, {"t0": 17.22, "t1": 17.36, "texto": "tú?"}]}, {"t0": 18.36, "t1": 19.18, "texto": "¿Qué quieres hacer?", "palabras": [{"t0": 18.36, "t1": 18.62, "texto": "¿Qué"}, {"t0": 18.62, "t1": 18.88, "texto": "quieres"}, {"t0": 18.88, "t1": 19.18, "texto": "hacer?"}]}, {"t0": 19.7, "t1": 21.74, "texto": "Quiero jugar con mis amigos en el parque.", "palabras": [{"t0": 19.7, "t1": 19.96, "texto": "Quiero"}, {"t0": 19.96, "t1": 20.24, "texto": "jugar"}, {"t0": 20.24, "t1": 20.46, "texto": "con"}, {"t0": 20.46, "t1": 20.66, "texto": "mis"}, {"t0": 20.66, "t1": 21.0, "texto": "amigos"}, {"t0": 21.0, "t1": 21.24, "texto": "en"}, {"t0": 21.24, "t1": 21.36, "texto": "el"}, {"t0": 21.36, "t1": 21.74, "texto": "parque."}]}, {"t0": 22.26, "t1": 24.2, "texto": "Muchas gracias y buenas noches.", "palabras": [{"t0": 22.26, "t1": 22.56, "texto": "Muchas"}, {"t0": 22.56, "t1": 23.0, "texto": "gracias"}, {"t0": 23.0, "t1": 23.46, "texto": "y"}, {"t0": 23.46, "t1": 23.7, "texto": "buenas"}, {"t0": 23.7, "t1": 24.2, "texto": "noches."}]}], "unidades": [{"seg": 0, "t0": 0.0, "t1": 0.22, "texto": "Hola,", "tipo": "deletreo", "letras": ["h", "o", "l", "a"]}, {"seg": 0, "t0": 0.5, "t1": 1.02, "texto": "buenos días.", "tipo": "signo", "tarjeta": "buenos-dias"}, {"seg": 1, "t0": 2.26, "t1": 2.5, "texto": "Me", "tipo": "omitir"}, {"seg": 1, "t0": 2.5, "t1": 2.74, "texto": 
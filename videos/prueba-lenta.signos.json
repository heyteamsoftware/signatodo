{"video": "prueba-lenta.mp4", "duracion": 78.75, "modelo": "small", "segmentos": [{"t0": 1.02, "t1": 1.74, "texto": "Buenos días.", "palabras": [{"t0": 1.02, "t1": 1.26, "texto": "Buenos"}, {"t0": 1.26, "t1": 1.74, "texto": "días."}]}, {"t0": 4.15, "t1": 6.09, "texto": "Hoy es lunes.", "palabras": [{"t0": 4.15, "t1": 4.49, "texto": "Hoy"}, {"t0": 5.56, "t1": 5.75, "texto": "es"}, {"t0": 5.75, "t1": 6.09, "texto": "lunes."}]}, {"t0": 8.58, "t1": 13.0, "texto": "La familia desayuna en la cocina.", "palabras": [{"t0": 8.58, "t1": 8.82, "texto": "La"}, {"t0": 8.82, "t1": 9.42, "texto": "familia"}, {"t0": 10.4, "t1": 11.14, "texto": "desayuna"}, {"t0": 12.1, "t1": 12.24, "texto": "en"}, {"t0": 12.24, "t1": 12.42, "texto": "la"}, {"t0": 12.42, "t1": 13.0, "texto": "cocina."}]}, {"t0": 15.4, "t1": 18.7, "texto": "El niño bebe leche.", "palabras": [{"t0": 15.4, "t1": 15.5, "texto": "El"}, {"t0": 15.5, "t1": 15.84, "texto": "niño"}, {"t0": 16.84, "t1": 17.26, "texto": "bebe"}, {"t0": 18.24, "t1": 18.7, "texto": "leche."}]}, {"t0": 21.38, "t1": 27.58, "texto": "La niña come pan con mantequilla.", "palabras": [{"t0": 21.38, "t1": 21.44, "texto": "La"}, {"t0": 21.44, "t1": 21.98, "texto": "niña"}, {"t0": 22.8, "t1": 23.14, "texto": "come"}, {"t0": 24.12, "t1": 24.36, "texto": "pan"}, {"t0": 25.38, "t1": 25.6, "texto": "con"}, {"t0": 26.7, "t1": 27.58, "texto": "mantequilla."}]}, {"t0": 29.85, "t1": 33.87, "texto": "Mamá prepara zumo de naranja.", "palabras": [{"t0": 29.85, "t1": 30.55, "texto": "Mamá"}, {"t0": 31.38, "t1": 32.05, "texto": "prepara"}, {"t0": 32.88, "t1": 33.21, "texto": "zumo"}, {"t0": 33.21, "t1": 33.33, "texto": "de"}, {"t0": 33.33, "t1": 33.87, "texto": "naranja."}]}, {"t0": 36.18, "t1": 43.7, "texto": "Después los niños van al colegio en autobús.", "palabras": [{"t0": 36.18, "t1": 36.8, "texto": "Después"}, {"t0": 37.88, "t1": 38.12, "texto": "los"}, {"t0": 38.12, "t1": 38.54, "texto": "niños"}, {"t0": 39.74, "t1": 39.98, "texto": "van"}, {"t0": 41.02, "t1":